# Copy to backend/.env for local development. Never commit .env.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# Supabase → Project → Connect → "Session pooler" URI (works on IPv4, needed for Render).
# Leave empty locally to use SQLite.
DATABASE_URL=

# Anthropic: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Brevo: SMTP & API → API keys. The sender email must be verified under Senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Lerato Alert
BREVO_SMS_SENDER=LeratoAlert
# Email only for now. Set to true later once you buy Brevo SMS credits.
SMS_ENABLED=false

# Google Cloud → enable "Places API (New)" → Credentials → API key
GOOGLE_MAPS_API_KEY=

# Only for production (Render sets its own hostname automatically)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
